[workspace]
members = [
    "src/rust/price-engine",
    "src/rust/exchanges",
    "src/rust/execution",
    "src/rust/strategies",
]

[workspace.package]
version = "0.1.0"
edition = "2021"

[workspace.dependencies]
tokio = { version = "1.32", features = ["full"] }
anyhow = "1.0"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
tracing = "0.1"
tracing-subscriber = "0.3"
async-trait = "0.1"
ethers = "2.0"
rust_decimal = "1.32"
chrono = "0.4"
rand = "0.8"

[[bin]]
name = "lightning-arbitrage"
path = "src/main.rs"

[dependencies]
tokio = { version = "1.32", features = ["full"] }
anyhow = "1.0"
rand = "0.8"
